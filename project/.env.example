# .env.example - copy this file to ".env" and put your own values in it.
#
#     cp .env.example .env        (Mac / Linux)
#     copy .env.example .env      (Windows)
#
# The real .env file is in .gitignore, so it is NEVER pushed to GitHub.

# ---- server ----
PORT=3001
FRONTEND_URL=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hotel_booking

# ---- login token ----
# Use a long random string. You can make one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=put_a_long_random_secret_here
JWT_EXPIRES_IN=2h

# ---- Claude API (used by the AI room description helper) ----
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
