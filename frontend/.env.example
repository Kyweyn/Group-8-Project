# .env.example - copy this to ".env" before you run npm run dev
#
# Vite only gives a variable to the React code if the name starts with VITE_.
# NOTE: everything in here ends up inside the built JavaScript, so NEVER put a
# secret (API key, password) in this file. Our Claude API key stays in the
# backend .env for exactly that reason.

VITE_API_URL=http://localhost:3001
